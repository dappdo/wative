{
  "name": "wative",
  "version": "2.1.5",
  "description": "A ready-to-use toolkit for scaffolding wallet-dispatch applications leveraging wative-core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dappdo/wative.git"
  },
  "homepage": "https://github.com/dappdo/wative#readme",
  "bugs": "https://github.com/dappdo/wative/issues",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browserIndex.d.ts",
        "default": "./dist/browserIndex.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "types": "./dist/corePassthrough.d.ts",
      "default": "./dist/corePassthrough.js"
    },
    "./core/node": {
      "types": "./dist/coreNodePassthrough.d.ts",
      "default": "./dist/coreNodePassthrough.js"
    },
    "./node": {
      "types": "./dist/nodeIndex.d.ts",
      "default": "./dist/nodeIndex.js"
    },
    "./node/bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./node/preflight": {
      "types": "./dist/preflight.d.ts",
      "default": "./dist/preflight.js"
    },
    "./node/session": {
      "types": "./dist/core/session.d.ts",
      "default": "./dist/core/session.js"
    },
    "./node/balances": {
      "types": "./dist/core/nodeBalanceStore.d.ts",
      "default": "./dist/core/nodeBalanceStore.js"
    },
    "./node/nonces": {
      "types": "./dist/core/nodeNonceStore.d.ts",
      "default": "./dist/core/nodeNonceStore.js"
    },
    "./node/paths": {
      "types": "./dist/core/paths.d.ts",
      "default": "./dist/core/paths.js"
    },
    "./node/container": {
      "types": "./dist/core/container.d.ts",
      "default": "./dist/core/container.js"
    },
    "./browser": {
      "types": "./dist/browserIndex.d.ts",
      "default": "./dist/browserIndex.js"
    },
    "./browser/siwe": {
      "types": "./dist/core/siwe.d.ts",
      "default": "./dist/core/siwe.js"
    },
    "./browser/validators": {
      "types": "./dist/core/validators.d.ts",
      "default": "./dist/core/validators.js"
    },
    "./browser/slug": {
      "types": "./dist/core/slug.d.ts",
      "default": "./dist/core/slug.js"
    },
    "./browser/secretInput": {
      "types": "./dist/core/secretInput.d.ts",
      "default": "./dist/core/secretInput.js"
    },
    "./browser/balances": {
      "types": "./dist/core/balanceStore.d.ts",
      "default": "./dist/core/balanceStore.js"
    },
    "./browser/nonces": {
      "types": "./dist/core/nonceStore.d.ts",
      "default": "./dist/core/nonceStore.js"
    },
    "./viewport": {
      "types": "./dist/core/viewportStore.d.ts",
      "default": "./dist/core/viewportStore.js"
    },
    "./sendMath": {
      "types": "./dist/core/sendMath.d.ts",
      "default": "./dist/core/sendMath.js"
    },
    "./passwordStrength": {
      "types": "./dist/core/passwordStrength.d.ts",
      "default": "./dist/core/passwordStrength.js"
    },
    "./errors": {
      "types": "./dist/core/errors.d.ts",
      "default": "./dist/core/errors.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "smoke:browser": "node --conditions=browser scripts/smoke-browser.mjs",
    "test": "node --import tsx --test --test-timeout=30000 --test-force-exit test/*.test.ts",
    "verify": "pnpm run typecheck && pnpm run typecheck:browser && pnpm run build && pnpm run smoke:browser && pnpm run test"
  },
  "dependencies": {
    "wative-core": "2.5.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "bs58": "5.0.0",
    "ethers": "6.17.0",
    "tsx": "^4.21.0",
    "tweetnacl": "1.0.3",
    "typescript": "^5.9.3"
  }
}