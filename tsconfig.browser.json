{
  // Browser-condition typecheck GATE for wative's portable surface.
  //
  // The main tsconfig uses `nodenext`, which resolves wative-core's `node` export
  // condition and pulls in @types/node — so it is BLIND to browser-condition
  // breakage by construction. This config resolves wative-core's `browser`
  // condition (customConditions) with NO node types and the DOM lib, so a module
  // that is supposed to be portable but accidentally imports a Node builtin, uses
  // the process lifecycle, or pulls a node-only wative-core binding fails HERE.
  //
  // Scope: the type-CLEAN portable modules. `nonceStore` IS included (it imports
  // only `viewportStore`, no `session`/`WalletBalances`). `balanceStore` and the
  // `browserIndex` barrel are the only portable modules left out: `balanceStore`
  // type-imports `WalletBalances`, which resolves THROUGH the Node-only `session`
  // module (session value-imports HybridProvider, absent from wative-core's browser
  // build), so it cannot type-check under the browser condition — and `browserIndex`
  // transitively pulls it. Those two are covered instead by the `smoke:browser`
  // runtime step in `verify` (a real `node --conditions=browser` import of the whole
  // browser surface), which catches an actual Node/wative-core runtime leak that a
  // Node-condition import test cannot.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "customConditions": ["browser"]
  },
  "include": [
    "src/core/viewportStore.ts",
    "src/core/sendMath.ts",
    "src/core/passwordStrength.ts",
    "src/core/errors.ts",
    "src/core/siwe.ts",
    "src/core/validators.ts",
    "src/core/slug.ts",
    "src/core/secretInput.ts",
    "src/core/nonceStore.ts"
  ]
}
