{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // nodenext (NOT bundler): wative-core's exports map lists `browser` before
    // `node`; bundler resolution applies neither condition and falls through to the
    // browser types — which omit FileSink/HybridProvider and expose IdbProvider, so
    // browser-only code would typecheck green and crash at runtime. nodenext picks
    // the node condition and enforces the explicit .js import extensions node needs.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "examples/**/*"],
  "exclude": ["node_modules", "dist"]
}
